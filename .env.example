# Copy this file to .env and fill in real values. .env is ignored by Git.
# The application works without any of this. The LLM is optional and off by default.
LLM_ENABLED=false
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
# Free models only: the ID must end in :free, or no request is sent. See docs/M10_AI_AGENT.md.
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
# Local limits on real requests, below OpenRouter's free tier. Retries count too.
LLM_MAX_REQUESTS_PER_MINUTE=10
LLM_MAX_REQUESTS_PER_DAY=40
